generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Rarity {
  N
  R
  SR
  SSR
  UR
}

/// ユーザーがアップロードした写真。パックに入れるとカードとして排出される。
model Image {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String // /uploads/... の公開パス
  rarity      Rarity
  userId      String? // 登録したユーザー（旧データは null）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collections UserCollection[]
  packImages  PackImage[]

  @@index([userId])
}

/// /api/upload で保存したファイルと、その持ち主
model Upload {
  id        String   @id @default(cuid())
  url       String   @unique
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Pack {
  id           String   @id @default(cuid())
  name         String
  description  String?
  thumbnailUrl String?
  price        Int? // 未使用（互換のため残置）
  rarityRates  String? // JSON: {"N":40,"R":30,"SR":20,"SSR":8,"UR":2}
  userId       String? // 作成者（旧データは null）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  packImages PackImage[]

  @@index([userId])
}

model PackImage {
  id      String @id @default(cuid())
  packId  String
  pack    Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  imageId String
  image   Image  @relation(fields: [imageId], references: [id])
  weight  Int    @default(1) // 未使用（互換のため残置）

  @@unique([packId, imageId])
  @@index([packId])
}

model UserCollection {
  id         String   @id @default(cuid())
  userId     String
  imageId    String
  image      Image    @relation(fields: [imageId], references: [id])
  count      Int      @default(1)
  obtainedAt DateTime @default(now())

  @@unique([userId, imageId])
  @@index([userId])
}

// NextAuth 用のモデル（Credentials + JWT のため Account/Session は現状未使用）
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  points           Int       @default(10)
  lastTapRewardAt  DateTime?
  tapRewardDay     DateTime? // シャッター報酬を数えている日（JST 0:00）
  tapRewardCount   Int       @default(0)
  lastDailyBonusAt DateTime?
  accounts         Account[]
  sessions         Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
