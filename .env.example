# データベース
#   手元: SQLite のファイル（相対パスは prisma/ ディレクトリ基準）
#   公開先（Vercel）: Turso のアドレス（libsql://<DB名>-<ユーザー名>.<地域>.turso.io）と、トークン
DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=""
# セッション署名用の秘密鍵。本番では必ず長いランダム文字列にする（例: openssl rand -base64 32）
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
# アップロード画像の保存先
#   手元: ディスク（省略時は ./data/uploads）
#   公開先（Vercel）: Vercel Blob。Blob ストアをプロジェクトにつなぐと BLOB_STORE_ID が自動で入る
#   （認証は Vercel が自動で行う。以前の方式の BLOB_READ_WRITE_TOKEN でもよい）
# UPLOAD_DIR="/var/lib/photogacha/uploads"
# BLOB_STORE_ID=""
